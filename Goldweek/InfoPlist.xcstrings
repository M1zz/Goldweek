    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek needs calendar access to find leave-like events you can import and to sync your registered leaves to your calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから休暇と思われる予定を見つけて取り込み、登録した休暇をカレンダーに同期するためにアクセス権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에서 휴가로 보이는 일정을 찾아 가져오고, 등록한 휴가를 캘린더에 동기화하기 위해 접근 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要日历访问权限,以便从日历中查找疑似休假的日程并导入,以及将已登记的休假同步到日历。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek benötigt Zugriff auf deinen Kalender, um urlaubsähnliche Termine zum Importieren zu finden und deine eingetragenen Urlaube mit dem Kalender zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek a besoin d’accéder à votre calendrier pour trouver les événements de congé à importer et synchroniser vos congés enregistrés avec votre calendrier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek necesita acceder a tu calendario para encontrar eventos que parezcan vacaciones e importarlos, y para sincronizar tus vacaciones registradas con el calendario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek ha bisogno di accedere al calendario per trovare gli eventi che sembrano ferie da importare e per sincronizzare le ferie registrate con il calendario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Goldweek precisa acessar seu calendário para encontrar eventos que parecem folgas e importá-los, e para sincronizar suas folgas registradas com o calendário."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek 需要存取你的行事曆，才能找出看起來像休假的行程並匯入，也能把已登記的休假同步到行事曆。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek heeft toegang tot je agenda nodig om verlofachtige afspraken te vinden die je kunt importeren en om je ingevoerde verlof met je agenda te synchroniseren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek behöver åtkomst till kalendern för att hitta händelser som liknar ledigheter som du kan importera och för att synka dina registrerade ledigheter till kalendern."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek trenger kalendertilgang for å finne ferielignende hendelser du kan importere, og for å synkronisere registrert ferie til kalenderen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek har brug for adgang til kalenderen for at finde ferielignende begivenheder, du kan importere, og for at synkronisere din registrerede ferie til kalenderen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek tarvitsee kalenterin käyttöoikeuden löytääkseen tuotavissa olevat lomalta näyttävät tapahtumat ja synkronoidakseen kirjatut lomasi kalenteriin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek potrzebuje dostępu do kalendarza, aby znaleźć wydarzenia przypominające urlop do zaimportowania i zsynchronizować Twoje urlopy z kalendarzem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek potřebuje přístup ke kalendáři, aby našel události podobné dovolené k importu a synchronizoval zapsanou dovolenou do kalendáře."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Goldweek χρειάζεται πρόσβαση στο ημερολόγιο για να βρίσκει συμβάντα που μοιάζουν με άδειες και να τα εισάγεις, και για να συγχρονίζει τις καταχωρισμένες άδειές σου με το ημερολόγιό σου."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek, içe aktarabileceğin izin benzeri etkinlikleri bulmak ve kayıtlı izinlerini takvimine senkronize etmek için takvim erişimine ihtiyaç duyar."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴가 신청 내역 화면을 촬영해 휴가 기록을 자동으로 등록하기 위해 카메라 접근 권한이 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is needed to photograph your leave request history and register your leaves automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休暇申請履歴の画面を撮影し、休暇記録を自動で登録するためにカメラへのアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要相机权限以拍摄休假申请记录页面并自动登记休假。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird benötigt, um deinen Urlaubsantragsverlauf zu fotografieren und deine Urlaube automatisch einzutragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo permet de photographier l’historique de vos demandes de congé et d’enregistrer vos congés automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la cámara para fotografiar tu historial de solicitudes de vacaciones y registrarlas automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla fotocamera serve per fotografare lo storico delle richieste di ferie e registrarle automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera é necessário para fotografar seu histórico de pedidos de folga e registrá-las automaticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用相機拍攝你的休假申請紀錄，並自動登記休假。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang is nodig om je verlofaanvragen te fotograferen en je verlof automatisch in te voeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåtkomst behövs för att fotografera din ledighetshistorik och registrera dina ledigheter automatiskt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameratilgang trengs for å ta bilde av ferieoversikten din og registrere ferie automatisk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er brug for kameraadgang for at fotografere din feriehistorik og registrere din ferie automatisk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran käyttöoikeus tarvitaan lomahakemushistoriasi kuvaamiseen ja lomien kirjaamiseen automaattisesti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest potrzebny, aby sfotografować historię wniosków urlopowych i automatycznie dodać Twoje urlopy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k fotoaparátu je potřeba k vyfocení historie žádostí o dovolenou a jejímu automatickému zapsání."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται πρόσβαση στην κάμερα για να φωτογραφίζεις το ιστορικό αιτήσεων άδειας και να καταχωρίζονται αυτόματα οι άδειές σου."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin talep geçmişini fotoğraflamak ve izinlerini otomatik kaydetmek için kamera erişimi gerekir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
