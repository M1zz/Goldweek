    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek needs calendar access to find leave-like events you can import and to sync your registered leaves to your calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから休暇と思われる予定を見つけて取り込み、登録した休暇をカレンダーに同期するためにアクセス権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에서 휴가로 보이는 일정을 찾아 가져오고, 등록한 휴가를 캘린더에 동기화하기 위해 접근 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要日历访问权限,以便从日历中查找疑似休假的日程并导入,以及将已登记的休假同步到日历。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek benötigt Zugriff auf deinen Kalender, um urlaubsähnliche Termine zum Importieren zu finden und deine eingetragenen Urlaube mit dem Kalender zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldweek a besoin d’accéder à votre calendrier pour trouver les événements de congé à importer et synchroniser vos congés enregistrés avec votre calendrier."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴가 신청 내역 화면을 촬영해 휴가 기록을 자동으로 등록하기 위해 카메라 접근 권한이 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is needed to photograph your leave request history and register your leaves automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休暇申請履歴の画面を撮影し、休暇記録を自動で登録するためにカメラへのアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要相机权限以拍摄休假申请记录页面并自动登记休假。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird benötigt, um deinen Urlaubsantragsverlauf zu fotografieren und deine Urlaube automatisch einzutragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo permet de photographier l’historique de vos demandes de congé et d’enregistrer vos congés automatiquement."
          }
        }
      }
    }
  },
  "version": "1.0"
}
