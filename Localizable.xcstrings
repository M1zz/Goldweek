    "올해 남은 연차를 알려 줍니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekne, kolik dní dovolené vám letos zbývá."
