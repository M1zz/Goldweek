        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos congés restants et vos prochaines vacances"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tus vacaciones restantes y tus próximos días libres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le ferie rimaste e le prossime pause"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja suas férias restantes e as próximas folgas"
