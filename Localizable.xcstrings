    "남은 연차와 다가오는 휴가를 확인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your remaining leave and upcoming vacations"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの有給と今後の休暇を確認しましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看剩余年假和即将到来的假期"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Resturlaub und kommende Urlaube im Blick"
